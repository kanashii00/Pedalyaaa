APP_NAME=Pedalya
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=https://pedalyaaa.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US_PHP

APP_MAINTENANCE_DRIVER=file

DB_CONNECTION=mysql
DB_HOST=your-aiven-host
DB_PORT=27661
DB_DATABASE=pedalya
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
# Base64-encoded Aiven CA certificate for verified TLS connections.
MYSQL_SSL_CA_BASE64=your-base64-encoded-aiven-ca

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=s3
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS=your-verified-sender-address
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

GEOFENCE_DEFAULT_RADIUS=500
GEOFENCE_WARNING_THRESHOLD=100
GEOFENCE_CENTER_LAT=14.5995
GEOFENCE_CENTER_LNG=120.9842

# Must match PEDALYA_API_KEY on the ESP32; do not generate or rotate casually.
DEVICE_API_KEY=
DEVICE_DISPLAY_POLL_SECONDS=15
# Both disks require the S3-compatible settings below.
ID_VERIFICATION_DISK=id_verifications_s3
AWS_ACCESS_KEY_ID=your-storage-access-key
AWS_SECRET_ACCESS_KEY=your-storage-secret-key
AWS_DEFAULT_REGION=your-storage-region
AWS_BUCKET=your-private-storage-bucket
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

RENTAL_RATE_PER_HOUR=15.00
RENTAL_MAX_DURATION_HOURS=12
DEPOSIT_AMOUNT=100.00

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Set this to the exact HTTPS web callback URI registered in Google Cloud.
# Also register https://pedalyaaa.onrender.com/api/auth/google/callback for mobile.
GOOGLE_REDIRECT_URI=https://pedalyaaa.onrender.com/auth/google/callback
