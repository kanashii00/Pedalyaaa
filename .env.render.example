APP_NAME=Pedalya
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=https://your-app.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US_PHP

APP_MAINTENANCE_DRIVER=file

DB_CONNECTION=mysql
DB_HOST=your-mysql-host.render.internal
DB_PORT=3306
DB_DATABASE=pedalya
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@pedalya.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

GEOFENCE_DEFAULT_RADIUS=500
GEOFENCE_WARNING_THRESHOLD=100
GEOFENCE_CENTER_LAT=14.5995
GEOFENCE_CENTER_LNG=120.9842

DEVICE_API_KEY=pedalya-iot-device-key-2024
DEVICE_DISPLAY_POLL_SECONDS=15

RENTAL_RATE_PER_HOUR=15.00
RENTAL_MAX_DURATION_HOURS=12
DEPOSIT_AMOUNT=100.00

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback
